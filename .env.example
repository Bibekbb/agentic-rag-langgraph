# LLM
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
DEFAULT_LLM=gpt-4o-mini
FAST_LLM=llama-3.3-70b-versatile

# Infra
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://user:pass@postgres:5432/rag

# RAG
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
CONFIDENCE_THRESHOLD=0.6
MAX_RETRIES=2

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
LOG_LEVEL=INFO